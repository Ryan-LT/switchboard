{
  "name": "@switchboard/agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 tsx watch src/index.ts",
    "start": "NODE_NO_WARNINGS=1 tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "hooks:print": "tsx src/hooks.ts print",
    "hooks:install": "tsx src/hooks.ts install",
    "autostart:install": "tsx src/autostart.ts install",
    "autostart:uninstall": "tsx src/autostart.ts uninstall",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "chokidar": "^5.0.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
